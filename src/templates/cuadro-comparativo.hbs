<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cuadro Comparativo {{codigoCuadro}}</title>
    {{> estilos-documento}}
    <style>
      .grilla th,
      .grilla td {
        font-size: 7.5pt;
      }
      /* Cotización recomendada y precio más bajo por ítem */
      .grilla .rec {
        background: #e2efda;
      }
      .grilla .gana {
        background: #f0f7ec;
      }
      .grilla .nomenciona {
        background: #f2f2f2;
        font-style: italic;
        text-align: center;
      }
    </style>
  </head>
  <body>
    <div class="hoja apaisada">
      {{> encabezado anexo="ANEXO 11" titulo="Cuadro Comparativo de Cotizaciones" nota="(Expresado en Bolivianos)" codigo=codigoCuadro}}

      <table class="grilla">
        <thead>
          <tr>
            <th rowspan="4" style="width: 3%">ITEM</th>
            <th rowspan="4" style="width: 22%">DESCRIPCIÓN</th>
            <th rowspan="4" style="width: 5%">CANT.</th>
            <th rowspan="4" style="width: 6%">UNID.</th>
            <th colspan="{{colspanCotizaciones}}">COTIZACIONES</th>
          </tr>
          <tr>
            {{#each columnas}}
              <th class="{{#if recomendada}}rec{{/if}}" colspan="2">{{proveedorNombre}}</th>
            {{/each}}
          </tr>
          <tr>
            {{#each columnas}}
              <th colspan="2">{{orden}}</th>
            {{/each}}
          </tr>
          <tr>
            {{#each columnas}}
              <th>P/UNIT.</th>
              <th>TOTAL</th>
            {{/each}}
          </tr>
        </thead>
        <tbody>
          {{#each items}}
            <tr>
              <td class="c">{{orden}}</td>
              <td>{{descripcion}}</td>
              <td class="c">{{cantidad}}</td>
              <td class="c">{{unidad}}</td>
              {{#each celdas}}
                {{#if noMenciona}}
                  <td class="nomenciona">No menciona</td>
                  <td class="r mono {{#if ganadora}}gana{{/if}}">0,00</td>
                {{else}}
                  <td class="r mono {{#if ganadora}}gana{{/if}}">{{precioUnitario}}</td>
                  <td class="r mono {{#if ganadora}}gana{{/if}}">{{total}}</td>
                {{/if}}
              {{/each}}
            </tr>
          {{/each}}
          <tr class="total">
            <td class="r" colspan="4">TOTALES</td>
            {{#each columnas}}
              <td></td>
              <td class="r mono {{#if recomendada}}rec{{/if}}">{{total}}</td>
            {{/each}}
          </tr>
        </tbody>
      </table>

      <table class="datos">
        <tr>
          <td class="etiqueta">Lugar y fecha:</td>
          <td class="valor">{{lugarFecha}}</td>
        </tr>
      </table>

      <div class="recuadro">
        <div class="b">Observaciones:</div>
        <div class="pre" style="min-height: 9mm">{{observaciones}}</div>
      </div>

      <table class="firmas no-romper">
        <tr>
          <td>
            <div class="firma-linea">Preparado por resp. cotización</div>
            <div class="firma-nombre">
              {{preparadoPor}}
              <div class="firma-cargo">{{preparadoCargo}}</div>
            </div>
          </td>
          <td>
            <div class="firma-linea">Revisado por</div>
            <div class="firma-nombre">
              {{revisadoPor}}
              <div class="firma-cargo">{{revisadoCargo}}</div>
            </div>
          </td>
          <td>
            <div class="firma-linea">Aprobado por</div>
            <div class="firma-nombre">
              {{aprobadoPor}}
              <div class="firma-cargo">{{aprobadoCargo}}</div>
            </div>
          </td>
        </tr>
      </table>
    </div>
  </body>
</html>

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ANEXO 1 {{codigoPlan}}</title>
    {{> estilos-documento}}
    <style>
      /* --- Cronograma --- */
      .cronograma {
        margin-top: 4mm;
        table-layout: fixed;
      }
      .cronograma th,
      .cronograma td {
        border: 1px solid #000;
        padding: 2px 3px;
      }
      .cronograma th {
        background: #d9d9d9;
        font-weight: bold;
        text-align: center;
        vertical-align: middle;
      }
      .cronograma th.sub {
        font-size: 7pt;
      }
      .cronograma td {
        height: 14mm;
        vertical-align: middle;
        text-align: center;
        word-wrap: break-word;
      }
      .cronograma td.actividad {
        text-align: left;
      }
      .cronograma td.aceaa {
        text-align: left;
        font-size: 7.5pt;
      }
      .aceaa div + div {
        margin-top: 1px;
      }

    </style>
  </head>
  <body>
    <div class="hoja">
      {{> encabezado anexo="ANEXO 1" titulo="PLANIFICACIÓN DE VIAJE"}}

      <table class="datos">
        <tr>
          <td class="etiqueta">NOMBRE:</td>
          <td class="valor">{{nombre}}</td>
        </tr>
        <tr>
          <td class="etiqueta">CARGO:</td>
          <td class="valor">{{cargo}}</td>
        </tr>
        <tr>
          <td class="etiqueta">LUGAR(es) DE VIAJE:</td>
          <td class="valor">{{lugaresViaje}}</td>
        </tr>
        <tr>
          <td class="etiqueta">OBJETIVO DEL VIAJE:</td>
          <td class="valor">{{objetivoViaje}}</td>
        </tr>
      </table>
      <div class="codigo">{{codigoPlan}}</div>

      <table class="cronograma">
        <colgroup>
          <col style="width: 14%" />
          <col style="width: 10.5%" />
          <col style="width: 10.5%" />
          <col style="width: 27%" />
          <col style="width: 25%" />
          <col style="width: 13%" />
        </colgroup>
        <thead>
          <tr>
            <th rowspan="2">Fechas</th>
            <th colspan="2">Lugar</th>
            <th rowspan="2">Actividad Programada</th>
            <th colspan="2">Participantes</th>
          </tr>
          <tr>
            <th>Salida</th>
            <th>Llegada</th>
            <th class="sub">De ACEAA (**)</th>
            <th class="sub">Terceros (*)</th>
          </tr>
        </thead>
        <tbody>
          {{#each filas}}
            <tr>
              <td>{{fechas}}</td>
              <td>{{salida}}</td>
              <td>{{llegada}}</td>
              <td class="actividad">{{actividad}}</td>
              <td class="aceaa">
                {{#each deAceaa}}
                  <div>{{this}}</div>
                {{/each}}
              </td>
              <td>{{terceros}}</td>
            </tr>
          {{/each}}
        </tbody>
      </table>

      <div class="notas">
        (*) Para las rendiciones se harán llegar adjunto el "Registro de Asistencia de la Actividad Programada" (si fuera el caso)<br />
        (**) Indicar nombre del personal que acompaña el viaje y/o actividad
      </div>

      <table class="emision">
        <tr>
          <td class="lugar">{{lugarEmision}}</td>
          <td class="fecha">{{fechaEmision}}</td>
        </tr>
      </table>

      <table class="firmas">
        <tr>
          <td>
            <div class="firma-linea">Responsable de viaje</div>
            <div class="firma-nombre">{{responsable}}</div>
          </td>
          <td></td>
          <td>
            <div class="firma-linea">VoBo. Director de Programa</div>
            <div class="firma-nombre">{{directorPrograma}}</div>
          </td>
        </tr>
      </table>
    </div>
  </body>
</html>

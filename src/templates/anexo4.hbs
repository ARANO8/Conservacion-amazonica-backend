<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ANEXO 4 {{codigoSolicitud}}</title>
    <style>
      @page {
        size: A4 landscape;
        margin: 10mm;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        background: #ffffff;
        color: #000000;
      }

      body {
        font-family: 'Bookman Old Style', 'Bookman', Georgia, serif;
        font-size: 7.5pt;
      }

      /* En pantalla la hoja se ve como papel; al imprimir manda @page */
      @media screen {
        body {
          padding: 12px;
        }
        .hoja {
          max-width: 277mm;
          margin: 0 auto;
        }
      }

      table {
        width: 100%;
        border-collapse: collapse;
      }

      td,
      th {
        padding: 1px 3px;
        vertical-align: middle;
      }

      .b {
        font-weight: bold;
      }
      .c {
        text-align: center;
      }
      .r {
        text-align: right;
        white-space: nowrap;
      }
      .gris {
        background: #bfbfbf;
      }
      .gris-claro {
        background: #d8d8d8;
      }
      .celeste {
        background: #ccffff;
      }
      .humo {
        background: #f2f2f2;
      }
      .amarillo {
        background: #ffff00;
      }
      .borde td,
      .borde th,
      td.borde,
      th.borde {
        border: 1px solid #000000;
      }
      .sin-borde {
        border: none !important;
        background: transparent !important;
      }

      .anexo {
        text-align: right;
        font-weight: bold;
        font-size: 10pt;
      }
      .titulo {
        text-align: center;
        font-weight: bold;
        font-size: 9pt;
        line-height: 1.25;
      }

      /* Encabezado de datos */
      .datos td {
        height: 14px;
      }
      .datos .etiqueta {
        font-weight: bold;
        white-space: nowrap;
        width: 22%;
      }
      .datos .valor {
        border-bottom: 1px solid #000000;
      }

      /* Tabla principal */
      .movimientos {
        margin-top: 8px;
      }
      .movimientos th {
        font-size: 7pt;
        line-height: 1.1;
      }
      .movimientos td {
        height: 15px;
      }
      .movimientos td.hueco,
      .movimientos th.hueco {
        border: none;
        background: transparent;
        width: 8px;
      }
      .movimientos .desc {
        text-align: left;
      }

      .bloque {
        margin-top: 10px;
      }
      .liquidacion td {
        height: 16px;
      }
      .firmas {
        margin-top: 34px;
        page-break-inside: avoid;
        break-inside: avoid;
      }
      .firmas td {
        text-align: center;
        vertical-align: top;
        width: 33%;
        padding: 0 28px;
      }
      .firmas .raya div {
        border-top: 1px solid #000000;
        padding-top: 3px;
      }
      .firmas .cargo {
        font-size: 6.5pt;
        text-transform: uppercase;
      }
    </style>
  </head>
  <body>
    <div class="hoja">
      <table>
        <colgroup>
          <col style="width: 49%" />
          <col style="width: 2%" />
          <col style="width: 49%" />
        </colgroup>
        <tr>
          <td class="logo">
            {{> logos}}
            <span class="anexo" style="float: right">ANEXO 4</span>
          </td>
          <td></td>
          <td></td>
        </tr>
        <tr>
          <td class="titulo gris">
            RENDICIÓN DE FONDOS EN AVANCE<br />(Expresado en Bolivianos)
          </td>
          <td></td>
          <td class="titulo gris">
            RETENCIONES IMPOSITIVAS<br />(Expresado en Bolivianos)
          </td>
        </tr>
      </table>

      <table class="datos" style="width: 49%; margin-top: 6px">
        <tr>
          <td class="etiqueta">A:</td>
          <td class="valor" colspan="3">{{a}}</td>
        </tr>
        <tr>
          <td class="etiqueta">DE:</td>
          <td class="valor" colspan="3">{{de}}</td>
        </tr>
        <tr>
          <td class="etiqueta">PROYECTO:</td>
          <td class="valor" colspan="3">{{proyecto}}</td>
        </tr>
        <tr>
          <td class="etiqueta">CÓDIGO DE ACTIVIDAD</td>
          <td class="valor" colspan="3">{{codigoActividad}}</td>
        </tr>
        <tr>
          <td class="etiqueta">CHEQUE A NOMBRE DE:</td>
          <td class="valor" colspan="3">{{chequeANombreDe}}</td>
        </tr>
        <tr>
          <td class="etiqueta">BANCO Y CUENTA BANCARIA N°</td>
          <td class="valor">{{bancoCuenta}}</td>
          <td class="etiqueta" style="width: 12%">CHEQUE N°</td>
          <td class="valor">{{chequeNro}}</td>
        </tr>
        <tr>
          <td class="etiqueta">FECHA ENTREGA DE FONDOS</td>
          <td class="valor" colspan="3">{{fechaEntrega}}</td>
        </tr>
        <tr>
          <td class="etiqueta">FECHA DE RENDICIÓN:</td>
          <td class="valor" colspan="3">{{fechaRendicion}}</td>
        </tr>
      </table>

      <table class="movimientos">
        <colgroup>
          <col style="width: 6.5%" />
          <col style="width: 6%" />
          <col style="width: 6%" />
          <col style="width: 7%" />
          <col style="width: 15%" />
          <col style="width: 6%" />
          <col style="width: 6%" />
          <col style="width: 6%" />
          <col style="width: 1%" />
          <col style="width: 6%" />
          <col style="width: 5.5%" />
          <col style="width: 5%" />
          <col style="width: 5%" />
          <col style="width: 6.5%" />
          <col style="width: 6.5%" />
        </colgroup>
        <tr class="borde gris">
          <th rowspan="2">FECHA</th>
          <th rowspan="2">N°<br />DOCTO.</th>
          <th rowspan="2">TIPO<br />DOCTO.</th>
          <th rowspan="2">PARTIDA</th>
          <th rowspan="2">DESCRIPCIÓN</th>
          <th colspan="3">MONTO BS</th>
          <th class="hueco" rowspan="2"></th>
          <th rowspan="2">TOTAL</th>
          <th>RC-IVA</th>
          <th>IUE</th>
          <th>IT</th>
          <th rowspan="2">TOTAL<br />IMPUESTOS</th>
          <th rowspan="2">NETO</th>
        </tr>
        <tr class="borde gris">
          <th>INGRESOS</th>
          <th>EGRESOS</th>
          <th>SALDO</th>
          <th>13%</th>
          <th>5%</th>
          <th>3%</th>
        </tr>
        {{#each filas}}
          <tr class="borde">
            <td class="c">{{fecha}}</td>
            <td class="c">{{nroDocto}}</td>
            <td class="c">{{tipoDocto}}</td>
            <td class="c">{{partida}}</td>
            <td class="desc {{#if esFondo}}b{{/if}}">{{descripcion}}</td>
            <td class="r">{{bs ingreso}}</td>
            <td class="r">{{bs egreso}}</td>
            <td class="r">{{bs saldo}}</td>
            <td class="hueco"></td>
            <td class="r">{{bs total}}</td>
            <td class="r">{{bs rcIva}}</td>
            <td class="r">{{bs iue}}</td>
            <td class="r">{{bs it}}</td>
            <td class="r">{{bs totalImpuestos}}</td>
            <td class="r">{{bs neto}}</td>
          </tr>
        {{/each}}
        <tr class="borde gris b">
          <td colspan="5" class="c">TOTAL</td>
          <td class="r">{{bs totales.ingresos}}</td>
          <td class="r">{{bs totales.egresos}}</td>
          <td class="r">{{bs totales.saldo}}</td>
          <td class="hueco"></td>
          <td class="r">{{bs totales.total}}</td>
          <td class="r">{{bs totales.rcIva}}</td>
          <td class="r">{{bs totales.iue}}</td>
          <td class="r">{{bs totales.it}}</td>
          <td class="r">{{bs totales.totalImpuestos}}</td>
          <td class="r">{{bs totales.neto}}</td>
        </tr>
      </table>

      <table class="bloque">
        <tr>
          <td class="b" style="width: 12%; vertical-align: top">Observaciones:</td>
          <td style="border-bottom: 1px solid #000">{{observaciones}}</td>
        </tr>
      </table>

      <table class="bloque">
        <colgroup>
          <col style="width: 49%" />
          <col style="width: 2%" />
          <col style="width: 49%" />
        </colgroup>
        <tr>
          <td style="vertical-align: top">
            <table class="liquidacion">
              <tr>
                <td class="b celeste borde" style="width: 30%">Importe recibido:</td>
                <td class="r humo borde" style="width: 20%">{{bs liquidacion.importeRecibido}}</td>
                <td style="width: 4%"></td>
                <td style="width: 26%"></td>
                <td style="width: 20%"></td>
              </tr>
              <tr>
                <td class="b celeste borde">Total gastado:</td>
                <td class="r humo borde">{{bs liquidacion.totalGastado}}</td>
                <td></td>
                <td class="b celeste borde">A favor del empleado:</td>
                <td class="r humo borde">{{bs liquidacion.aFavorEmpleado}}</td>
              </tr>
              <tr>
                <td class="b celeste borde">Saldo:</td>
                <td class="r humo borde">{{bs liquidacion.saldo}}</td>
                <td></td>
                <td class="b celeste borde">A favor del Proyecto:</td>
                <td class="r humo borde">{{bs liquidacion.aFavorProyecto}}</td>
              </tr>
            </table>
          </td>
          <td></td>
          <td style="vertical-align: top">
            <table class="liquidacion borde">
              <tr class="gris b">
                <td class="c">Documentos</td>
                <td class="c" style="width: 22%">Cantidad</td>
                <td class="c" style="width: 30%">Monto Bs</td>
              </tr>
              <tr>
                <td>Facturas</td>
                <td class="c">{{documentos.facturasCantidad}}</td>
                <td class="r">{{bs documentos.facturasMonto}}</td>
              </tr>
              <tr>
                <td>Recibos y otros</td>
                <td class="c">{{documentos.recibosCantidad}}</td>
                <td class="r">{{bs documentos.recibosMonto}}</td>
              </tr>
              <tr class="gris b">
                <td class="c">TOTAL</td>
                <td class="c">{{documentos.totalCantidad}}</td>
                <td class="r">{{bs documentos.totalMonto}}</td>
              </tr>
            </table>
          </td>
        </tr>
      </table>

      <table class="bloque borde" style="width: 49%">
        <tr class="gris-claro b">
          <td colspan="3">RESUMEN CONTABLE</td>
        </tr>
        <tr class="gris-claro b">
          <td class="c">NOMBRE PARTIDA</td>
          <td class="c" style="width: 26%">CÓDIGO PARTIDA</td>
          <td class="c" style="width: 22%">MONTO</td>
        </tr>
        {{#each resumenContable}}
          <tr>
            <td>{{nombre}}</td>
            <td class="c">{{codigo}}</td>
            <td class="r">{{bs monto}}</td>
          </tr>
        {{else}}
          <tr>
            <td>&nbsp;</td>
            <td></td>
            <td></td>
          </tr>
        {{/each}}
        <tr class="gris-claro b">
          <td colspan="2" class="c">TOTAL</td>
          <td class="r">{{bs resumenContableTotal}}</td>
        </tr>
      </table>

      <table class="firmas">
        <tr>
          <td class="raya"><div>Elaborado por:</div></td>
          <td class="raya"><div>Revisado por:</div></td>
          <td class="raya"><div>Aprobado por:</div></td>
        </tr>
        <tr>
          <td>{{firmas.elaboradoPor.nombre}}</td>
          <td>{{firmas.revisadoPor.nombre}}</td>
          <td>{{firmas.aprobadoPor.nombre}}</td>
        </tr>
        <tr>
          <td class="cargo">{{firmas.elaboradoPor.cargo}}</td>
          <td class="cargo">{{firmas.revisadoPor.cargo}}</td>
          <td class="cargo">{{firmas.aprobadoPor.cargo}}</td>
        </tr>
      </table>
    </div>
  </body>
</html>

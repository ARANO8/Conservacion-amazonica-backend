{{!--
  Encabezado común: logos de ACEAA y de AMZ desk a la izquierda; a la derecha
  el anexo, el título en banda gris y, debajo, el código del documento.
  Uso: {{> encabezado anexo="ANEXO 1" titulo="PLANIFICACIÓN DE VIAJE" codigo=codigoPlan}}
  Parámetros opcionales: anexo, nota, codigo, referencia (otro documento).
--}}
<table class="encabezado">
  <tr>
    <td rowspan="2" class="logos">{{> logos}}</td>
    <td class="anexo">{{anexo}}</td>
  </tr>
  <tr>
    <td class="titulo">
      {{titulo}}
      {{#if nota}}<div class="nota">{{nota}}</div>{{/if}}
    </td>
  </tr>
</table>
{{#if codigo}}<div class="codigo">{{codigo}}{{#if referencia}} · Ref: {{referencia}}{{/if}}</div>{{/if}}

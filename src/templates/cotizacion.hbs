<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Formulario de Solicitud de Cotizaciones {{codigoCotizacion}}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
      @page {
        size: A4;
        margin: 16mm;
      }

      body {
        font-family: Georgia, 'Times New Roman', serif;
      }

      .avoid-break {
        page-break-inside: avoid;
        break-inside: avoid;
      }

      .leader {
        flex: 1 1 auto;
        border-bottom: 1px dotted #334155;
        min-height: 1.05rem;
        padding-left: 4px;
      }

      .lbl {
        font-style: italic;
        font-weight: 700;
        white-space: nowrap;
      }

      table.cot {
        width: 100%;
        border-collapse: collapse;
      }

      table.cot th,
      table.cot td {
        border: 1px solid #334155;
        padding: 5px 6px;
      }

      table.cot td.cell {
        height: 26px;
      }
    </style>
  </head>
  <body class="bg-white text-[11px] text-slate-900">
    <header class="mb-4">
      <div
        class="flex items-center gap-4 border border-slate-400 bg-slate-100 px-4 py-3"
      >
        <div class="flex w-28 shrink-0 items-center">
          {{#if logoBase64}}
            <img
              src="data:image/png;base64,{{logoBase64}}"
              alt="Conservación Amazónica"
              class="h-12 w-auto object-contain"
            />
          {{/if}}
        </div>
        <div class="flex-1 text-center">
          <h1
            class="text-[15px] font-bold uppercase tracking-wide text-slate-900"
          >
            Formulario de Solicitud de Cotizaciones
          </h1>
          <p class="text-[10px] font-bold text-slate-700">
            (Expresado en Bolivianos)
          </p>
        </div>
        <div class="w-28 shrink-0 text-right text-[8px] text-slate-500">
          {{codigoCotizacion}}
        </div>
      </div>
    </header>

    <section class="mb-3 space-y-1.5 text-[11px]">
      <div class="flex gap-2">
        <span class="lbl">Fecha:</span>
        <span class="leader">{{fecha}}</span>
      </div>
      <div class="flex gap-6">
        <div class="flex flex-1 gap-2">
          <span class="lbl">Señor(es):</span>
          <span class="leader">{{proveedorNombre}}</span>
        </div>
        <div class="flex w-1/3 gap-2">
          <span class="lbl">Teléfono:</span>
          <span class="leader">{{proveedorTelefono}}</span>
        </div>
      </div>
      <div class="flex gap-2">
        <span class="lbl">Dirección:</span>
        <span class="leader">{{proveedorDireccion}}</span>
      </div>
      <div class="flex gap-2">
        <span class="lbl">Correo Electrónico:</span>
        <span class="leader">{{proveedorCorreo}}</span>
      </div>
    </section>

    <p class="mb-3 text-[10px] italic">
      Por nuestra cuenta agradeceremos cotizar los siguientes servicios o
      materiales de acuerdo a detalle adjunto.
    </p>

    <section class="mb-6">
      <table class="cot text-[10px]">
        <thead>
          <tr class="bg-slate-200 text-slate-800">
            <th class="w-[11%] text-center">CANTIDAD</th>
            <th class="w-[13%] text-center">UNIDAD</th>
            <th class="text-center">DETALLE</th>
            <th class="w-[15%] text-center">P/UNIT.</th>
            <th class="w-[15%] text-center">TOTAL BS.</th>
          </tr>
        </thead>
        <tbody>
          {{#each lineas}}
            <tr>
              <td class="cell text-center">{{cantidad}}</td>
              <td class="cell">{{unidad}}</td>
              <td class="cell">{{detalle}}</td>
              <td class="cell text-right">{{precioUnitario}}</td>
              <td class="cell text-right">{{total}}</td>
            </tr>
          {{/each}}
          {{#each filasVacias}}
            <tr>
              <td class="cell">&nbsp;</td>
              <td class="cell">&nbsp;</td>
              <td class="cell">&nbsp;</td>
              <td class="cell">&nbsp;</td>
              <td class="cell">&nbsp;</td>
            </tr>
          {{/each}}
          <tr class="bg-slate-200 font-bold">
            <td class="text-right" colspan="4">TOTAL</td>
            <td class="text-right">{{total}}</td>
          </tr>
          <tr>
            <td colspan="5" class="px-2 py-2">
              <div class="flex items-baseline gap-2">
                <span class="lbl">SON:</span>
                <span class="flex-1 italic">{{totalEnLetras}}</span>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </section>

    <section class="avoid-break mb-8 space-y-2 px-1 text-[11px]">
      <div class="flex gap-6">
        <div class="flex flex-1 gap-2">
          <span class="lbl">Garantía:</span>
          <span class="leader">{{garantia}}</span>
        </div>
        <div class="flex w-2/5 gap-2">
          <span class="lbl">Disponibilidad :</span>
          <span class="leader">{{disponibilidad}}</span>
        </div>
      </div>
      <div class="flex gap-6">
        <div class="flex flex-1 gap-2">
          <span class="lbl">Duración Cotización:</span>
          <span class="leader">{{duracionCotizacion}}</span>
        </div>
        <div class="flex w-2/5 gap-2">
          <span class="lbl">Emite Factura:</span>
          <span class="leader">{{emiteFactura}}</span>
        </div>
      </div>
      <div class="flex gap-2">
        <span class="lbl">Observaciones:</span>
        <span class="leader">{{observaciones}}</span>
      </div>
      <div class="flex gap-2">
        <span class="lbl invisible">Observaciones:</span>
        <span class="leader">&nbsp;</span>
      </div>
    </section>

    <section class="avoid-break mt-10 pl-10 text-[11px]">
      <p class="mb-12 font-bold">POR EL PROVEEDOR</p>
      <p class="mb-10 flex items-baseline gap-2">
        <span class="font-bold">FIRMA:</span>
        <span class="inline-block w-72 border-b border-dotted border-slate-600"
        >&nbsp;</span>
      </p>
      <p class="font-bold">SELLO DE LA EMPRESA:</p>
    </section>
  </body>
</html>

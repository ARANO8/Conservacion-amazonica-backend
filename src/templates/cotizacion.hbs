<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Formulario de Solicitud de Cotizaciones {{codigoCotizacion}}</title>
    {{> estilos-documento}}
    <style>
      .datos .etiqueta {
        width: 38mm;
      }
      .datos .valor.corto {
        width: 45mm;
      }
      .aviso {
        margin-top: 4mm;
        font-style: italic;
      }
      .grilla td {
        height: 7mm;
      }
      .proveedor {
        margin-top: 12mm;
        padding-left: 8mm;
        font-weight: bold;
      }
      .proveedor p {
        margin: 0 0 11mm;
      }
      .proveedor .linea {
        display: inline-block;
        width: 75mm;
        border-bottom: 1px dotted #000000;
      }
    </style>
  </head>
  <body>
    <div class="hoja">
      {{> encabezado titulo="Formulario de Solicitud de Cotizaciones" nota="(Expresado en Bolivianos)" codigo=codigoCotizacion}}

      <table class="datos">
        <tr>
          <td class="etiqueta">Fecha:</td>
          <td class="valor" colspan="3">{{fecha}}</td>
        </tr>
        <tr>
          <td class="etiqueta">Señor(es):</td>
          <td class="valor">{{proveedorNombre}}</td>
          <td class="etiqueta r">Teléfono:</td>
          <td class="valor corto">{{proveedorTelefono}}</td>
        </tr>
        <tr>
          <td class="etiqueta">Dirección:</td>
          <td class="valor" colspan="3">{{proveedorDireccion}}</td>
        </tr>
        <tr>
          <td class="etiqueta">Correo electrónico:</td>
          <td class="valor" colspan="3">{{proveedorCorreo}}</td>
        </tr>
      </table>

      <p class="aviso">
        Por nuestra cuenta agradeceremos cotizar los siguientes servicios o
        materiales de acuerdo a detalle adjunto.
      </p>

      <table class="grilla">
        <thead>
          <tr>
            <th style="width: 11%">CANTIDAD</th>
            <th style="width: 13%">UNIDAD</th>
            <th>DETALLE</th>
            <th style="width: 15%">P/UNIT.</th>
            <th style="width: 15%">TOTAL BS.</th>
          </tr>
        </thead>
        <tbody>
          {{#each lineas}}
            <tr>
              <td class="c">{{cantidad}}</td>
              <td>{{unidad}}</td>
              <td>{{detalle}}</td>
              <td class="r mono">{{precioUnitario}}</td>
              <td class="r mono">{{total}}</td>
            </tr>
          {{/each}}
          {{#each filasVacias}}
            <tr>
              <td>&nbsp;</td>
              <td>&nbsp;</td>
              <td>&nbsp;</td>
              <td>&nbsp;</td>
              <td>&nbsp;</td>
            </tr>
          {{/each}}
          <tr class="total">
            <td class="r" colspan="4">TOTAL</td>
            <td class="r mono">{{total}}</td>
          </tr>
          <tr>
            <td colspan="5"><span class="b">SON:</span> <span class="i">{{totalEnLetras}}</span></td>
          </tr>
        </tbody>
      </table>

      <table class="datos no-romper">
        <tr>
          <td class="etiqueta">Garantía:</td>
          <td class="valor">{{garantia}}</td>
          <td class="etiqueta r">Disponibilidad:</td>
          <td class="valor corto">{{disponibilidad}}</td>
        </tr>
        <tr>
          <td class="etiqueta">Duración cotización:</td>
          <td class="valor">{{duracionCotizacion}}</td>
          <td class="etiqueta r">Emite factura:</td>
          <td class="valor corto">{{emiteFactura}}</td>
        </tr>
        <tr>
          <td class="etiqueta">Observaciones:</td>
          <td class="valor" colspan="3">{{observaciones}}</td>
        </tr>
        <tr>
          <td class="etiqueta"></td>
          <td class="valor" colspan="3">&nbsp;</td>
        </tr>
      </table>

      <div class="proveedor no-romper">
        <p>POR EL PROVEEDOR</p>
        <p>FIRMA: <span class="linea">&nbsp;</span></p>
        <p>SELLO DE LA EMPRESA:</p>
      </div>
    </div>
  </body>
</html>

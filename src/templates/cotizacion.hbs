<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Formulario de Solicitud de Cotizaciones {{codigoCotizacion}}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
      @page {
        size: A4;
        margin: 18mm;
      }

      body {
        font-family: 'Segoe UI', Tahoma, sans-serif;
      }

      .avoid-break {
        page-break-inside: avoid;
        break-inside: avoid;
      }

      .field-line {
        border-bottom: 1px dotted #475569;
        min-height: 1.1rem;
      }
    </style>
  </head>
  <body class="bg-white text-[11px] text-slate-900">
    <header class="mb-5">
      <div class="flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          {{#if logoBase64}}
            <img
              src="data:image/png;base64,{{logoBase64}}"
              alt="Logo AMZ"
              class="h-14 w-auto object-contain"
            />
          {{/if}}
        </div>
        <div class="flex-1 text-center">
          <h1 class="text-lg font-bold uppercase tracking-wide">
            Formulario de Solicitud de Cotizaciones
          </h1>
          <p class="text-xs font-semibold text-slate-600">
            (Expresado en Bolivianos)
          </p>
        </div>
        <div class="text-right text-[10px] text-slate-500">
          <p class="font-semibold">Código</p>
          <p>{{codigoCotizacion}}</p>
        </div>
      </div>
    </header>

    <section class="mb-4 grid grid-cols-2 gap-x-8 gap-y-2 text-[11px]">
      <div class="flex gap-2">
        <span class="font-semibold italic">Fecha:</span>
        <span class="field-line flex-1">{{fecha}}</span>
      </div>
      <div class="flex gap-2">
        <span class="font-semibold italic">Teléfono:</span>
        <span class="field-line flex-1">{{proveedorTelefono}}</span>
      </div>
      <div class="col-span-2 flex gap-2">
        <span class="font-semibold italic">Señor(es):</span>
        <span class="field-line flex-1">{{proveedorNombre}}</span>
      </div>
      <div class="col-span-2 flex gap-2">
        <span class="font-semibold italic">Dirección:</span>
        <span class="field-line flex-1">{{proveedorDireccion}}</span>
      </div>
      <div class="col-span-2 flex gap-2">
        <span class="font-semibold italic">Correo Electrónico:</span>
        <span class="field-line flex-1">{{proveedorCorreo}}</span>
      </div>
    </section>

    <p class="mb-3 text-[11px]">
      Por nuestra cuenta agradeceremos cotizar los siguientes servicios o
      materiales de acuerdo a detalle adjunto.
    </p>

    <section class="mb-4">
      <table class="w-full border-collapse text-[10px]">
        <thead>
          <tr class="bg-slate-100 text-slate-700">
            <th class="border border-slate-400 px-2 py-2 text-center w-[12%]">
              CANTIDAD
            </th>
            <th class="border border-slate-400 px-2 py-2 text-center w-[14%]">
              UNIDAD
            </th>
            <th class="border border-slate-400 px-2 py-2 text-center">
              DETALLE
            </th>
            <th class="border border-slate-400 px-2 py-2 text-center w-[15%]">
              P/UNIT.
            </th>
            <th class="border border-slate-400 px-2 py-2 text-center w-[15%]">
              TOTAL BS.
            </th>
          </tr>
        </thead>
        <tbody>
          {{#each lineas}}
            <tr>
              <td class="border border-slate-400 px-2 py-2 text-center">
                {{cantidad}}
              </td>
              <td class="border border-slate-400 px-2 py-2 text-center">
                {{unidad}}
              </td>
              <td class="border border-slate-400 px-2 py-2">{{detalle}}</td>
              <td class="border border-slate-400 px-2 py-2 text-right">
                {{precioUnitario}}
              </td>
              <td class="border border-slate-400 px-2 py-2 text-right">
                {{total}}
              </td>
            </tr>
          {{/each}}
          <tr class="bg-slate-50 font-semibold">
            <td
              class="border border-slate-400 px-2 py-2 text-right"
              colspan="4"
            >
              TOTAL
            </td>
            <td class="border border-slate-400 px-2 py-2 text-right">
              {{total}}
            </td>
          </tr>
        </tbody>
      </table>
    </section>

    <section class="mb-5 flex gap-2 text-[11px]">
      <span class="font-semibold italic">SON:</span>
      <span class="field-line flex-1">{{totalEnLetras}}</span>
    </section>

    <section
      class="avoid-break mb-6 grid grid-cols-2 gap-x-8 gap-y-3 text-[11px]"
    >
      <div class="flex gap-2">
        <span class="font-semibold italic">Garantía:</span>
        <span class="field-line flex-1">{{garantia}}</span>
      </div>
      <div class="flex gap-2">
        <span class="font-semibold italic">Disponibilidad:</span>
        <span class="field-line flex-1">{{disponibilidad}}</span>
      </div>
      <div class="flex gap-2">
        <span class="font-semibold italic">Duración Cotización:</span>
        <span class="field-line flex-1">{{duracionCotizacion}}</span>
      </div>
      <div class="flex gap-2">
        <span class="font-semibold italic">Emite Factura:</span>
        <span class="field-line flex-1">{{emiteFactura}}</span>
      </div>
      <div class="col-span-2 flex gap-2">
        <span class="font-semibold italic">Observaciones:</span>
        <span class="field-line flex-1">{{observaciones}}</span>
      </div>
    </section>

    <section class="avoid-break mt-12 text-[11px]">
      <p class="mb-10 font-semibold">POR EL PROVEEDOR</p>
      <p class="mb-10">
        <span class="font-semibold">FIRMA:</span>
        <span
          class="ml-2 inline-block w-64 border-b border-slate-500"
        ></span>
      </p>
      <p>
        <span class="font-semibold">SELLO DE LA EMPRESA:</span>
      </p>
    </section>
  </body>
</html>

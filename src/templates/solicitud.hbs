<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Solicitud de Fondos {{codigoSolicitud}}</title>
    {{> estilos-documento}}
    <style>
      .ficha .etiqueta {
        width: 38mm;
      }
      .montos td {
        width: 50%;
      }
      .montos .importe {
        font-size: 11pt;
        font-weight: bold;
      }
    </style>
  </head>
  <body>
    <div class="hoja">
      {{#if esCompra}}
        {{> encabezado anexo="ANEXO 3" titulo=tituloDocumento nota="(Expresado en Bolivianos)" codigo=codigoSolicitud}}
      {{else}}
        {{> encabezado titulo=tituloDocumento nota="(Expresado en Bolivianos)" codigo=codigoSolicitud}}
      {{/if}}

      <div class="seccion">Datos generales</div>
      <table class="ficha no-romper" style="margin-top: 1mm">
        <tr>
          <td class="etiqueta">Fecha de solicitud</td>
          <td colspan="3">{{fechaSolicitud}}</td>
        </tr>
        <tr>
          <td class="etiqueta">Emisor</td>
          <td>{{emisorNombre}}</td>
          <td class="etiqueta">Cargo</td>
          <td>{{emisorCargo}}</td>
        </tr>
        <tr>
          <td class="etiqueta">Aprobador</td>
          <td colspan="3">{{aprobadorNombre}}</td>
        </tr>
        {{#if esCompra}}
          {{#if proyecto}}
            <tr>
              <td class="etiqueta">Proyecto</td>
              <td colspan="3">{{proyecto}}</td>
            </tr>
          {{/if}}
          <tr>
            <td class="etiqueta">Motivo</td>
            <td colspan="3">{{motivoViaje}}</td>
          </tr>
          {{#if codigoActividad}}
            <tr>
              <td class="etiqueta">Código de actividad</td>
              <td colspan="3">{{codigoActividad}}</td>
            </tr>
          {{/if}}
          {{#if chequeANombreDe}}
            <tr>
              <td class="etiqueta">Cheque a nombre de</td>
              <td colspan="3">{{chequeANombreDe}}</td>
            </tr>
          {{/if}}
        {{else}}
          <tr>
            <td class="etiqueta">Lugar de viaje</td>
            <td colspan="3">{{lugarViaje}}</td>
          </tr>
          <tr>
            <td class="etiqueta">Motivo</td>
            <td colspan="3">{{motivoViaje}}</td>
          </tr>
          <tr>
            <td class="etiqueta">Fecha inicio</td>
            <td>{{fechaInicio}}</td>
            <td class="etiqueta">Fecha fin</td>
            <td>{{fechaFin}}</td>
          </tr>
        {{/if}}
        <tr>
          <td class="etiqueta">Cuenta bancaria</td>
          <td colspan="3">
            {{#if cuentaBancaria}}
              {{cuentaBancaria.banco}} - {{cuentaBancaria.numeroCuenta}}
              {{#if cuentaBancaria.moneda}}({{cuentaBancaria.moneda}}){{/if}}
            {{else}}
              No asignada
            {{/if}}
          </td>
        </tr>
      </table>

      <div class="seccion">Resumen financiero</div>
      <table class="grilla montos no-romper" style="margin-top: 1mm">
        <tr>
          <th>TOTAL PRESUPUESTADO</th>
          <th>TOTAL NETO SOLICITADO</th>
        </tr>
        <tr>
          <td class="c importe mono">{{montoTotalPresupuestado}}</td>
          <td class="c importe mono">{{montoTotalNeto}}</td>
        </tr>
      </table>

      {{#if codigoDesembolso}}
        <div class="seccion">Datos del desembolso</div>
        <table class="ficha no-romper" style="margin-top: 1mm">
          <tr>
            <td class="etiqueta">Código de desembolso</td>
            <td colspan="3" class="mono">{{codigoDesembolso}}</td>
          </tr>
          {{#if banco}}
            <tr>
              <td class="etiqueta">Banco</td>
              <td colspan="3">{{banco}}</td>
            </tr>
          {{/if}}
          {{#if fechaDesembolso}}
            <tr>
              <td class="etiqueta">Fecha de desembolso</td>
              <td colspan="3">{{fechaDesembolso}}</td>
            </tr>
          {{/if}}
          {{#if urlComprobante}}
            <tr>
              <td class="etiqueta">Comprobante</td>
              <td colspan="3">{{urlComprobante}}</td>
            </tr>
          {{/if}}
        </table>
      {{/if}}

      <div class="seccion">Detalle de la solicitud</div>
      <table class="grilla" style="margin-top: 1mm">
        <thead>
          <tr>
            <th style="width: 16%">TIPO</th>
            <th>DESCRIPCIÓN</th>
            <th style="width: 18%">CANTIDAD</th>
            <th style="width: 18%">MONTO NETO</th>
          </tr>
        </thead>
        <tbody>
          {{#if detalle.length}}
            {{#each detalle}}
              <tr>
                <td>{{categoria}}</td>
                <td>{{descripcion}}</td>
                <td class="c">{{cantidad}}</td>
                <td class="r mono">{{montoNeto}}</td>
              </tr>
            {{/each}}
          {{else}}
            <tr>
              <td class="c" colspan="4">Sin detalle económico registrado.</td>
            </tr>
          {{/if}}
        </tbody>
      </table>

      {{#if cronograma.length}}
        <div class="seccion">Cronograma de pagos</div>
        <table class="grilla" style="margin-top: 1mm">
          <thead>
            <tr>
              <th style="width: 8%">PAGO</th>
              <th>PRODUCTO / HITO</th>
              <th style="width: 20%">FECHA PREVISTA</th>
              <th style="width: 15%">ESTADO</th>
              <th style="width: 16%">MONTO</th>
            </tr>
          </thead>
          <tbody>
            {{#each cronograma}}
              <tr>
                <td class="c">{{numero}}</td>
                <td>{{descripcion}}</td>
                <td class="c">
                  {{fechaPago}}
                  {{#if fechaPagoReal}}<div class="i">Pagado: {{fechaPagoReal}}</div>{{/if}}
                </td>
                <td class="c">{{estado}}</td>
                <td class="r mono">{{monto}}</td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      {{/if}}

      <table class="firmas no-romper">
        <tr>
          <td>
            <div class="firma-linea">Emitido por</div>
            <div class="firma-nombre">
              {{firmas.emitidoPor.nombre}}
              <div class="firma-cargo">{{firmas.emitidoPor.cargo}}</div>
            </div>
          </td>
          <td>
            <div class="firma-linea">Director del proyecto</div>
            <div class="firma-nombre">
              {{firmas.directorProyecto.nombre}}
              <div class="firma-cargo">{{firmas.directorProyecto.cargo}}</div>
            </div>
          </td>
          <td>
            <div class="firma-linea">Aprobado por</div>
            <div class="firma-nombre">
              {{firmas.aprobadoPor.nombre}}
              <div class="firma-cargo">{{firmas.aprobadoPor.cargo}}</div>
            </div>
          </td>
        </tr>
      </table>
    </div>
  </body>
</html>

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Orden de Compra/Servicio {{codigoOrden}}</title>
    {{> estilos-documento}}
    <style>
      .sin-cuadro {
        font-size: 6.5pt;
        font-style: italic;
        border: 1px solid #7f7f7f;
        padding: 0 2px;
      }
      .recepcion td {
        width: 50%;
        vertical-align: top;
      }
      .recepcion .datos {
        margin-top: 2mm;
      }
      .recepcion .datos .etiqueta {
        width: 34mm;
      }
    </style>
  </head>
  <body>
    <div class="hoja">
      {{> encabezado anexo="ANEXO 12" titulo="Orden de Compra / Servicio" nota="(Expresado en Bolivianos)" codigo=codigoOrden referencia=cuadroCodigo}}

      <table class="ficha">
        <tr>
          <td class="etiqueta">Fecha</td>
          <td colspan="3">{{fecha}}</td>
          <td class="etiqueta">T/C</td>
          <td>1 USD = Bs {{tc}}</td>
        </tr>
        <tr>
          <td class="etiqueta">Proveedor / Empresa</td>
          <td colspan="5">{{proveedorNombre}}</td>
        </tr>
        <tr>
          <td class="etiqueta">Dirección</td>
          <td colspan="2">{{proveedorDireccion}}</td>
          <td class="etiqueta">Teléfono</td>
          <td colspan="2">{{proveedorTelefono}}</td>
        </tr>
        <tr>
          <td class="etiqueta">Factura a nombre de</td>
          <td colspan="2">ACEAA</td>
          <td class="etiqueta">NIT</td>
          <td colspan="2">{{nit}}</td>
        </tr>
      </table>

      <table class="grilla">
        <thead>
          <tr>
            <th style="width: 4%">N°</th>
            <th style="width: 28%">ARTÍCULO / SERVICIO</th>
            <th style="width: 8%">CANTIDAD</th>
            <th style="width: 8%">UNIDAD</th>
            <th>DETALLE</th>
            <th style="width: 13%">PRECIO UNIT. (Bs)</th>
            <th style="width: 13%">TOTAL (Bs)</th>
          </tr>
        </thead>
        <tbody>
          {{#each items}}
            <tr>
              <td class="c">{{orden}}</td>
              <td>
                {{item}}
                {{#if sinCuadro}}<span class="sin-cuadro">sin cuadro</span>{{/if}}
              </td>
              <td class="c">{{cantidad}}</td>
              <td class="c">{{unidad}}</td>
              <td>{{detalle}}</td>
              <td class="r mono">{{precioUnitario}}</td>
              <td class="r mono">{{total}}</td>
            </tr>
          {{/each}}
          <tr class="total">
            <td class="r" colspan="6">TOTAL</td>
            <td class="r mono">{{total}}</td>
          </tr>
        </tbody>
      </table>

      <table class="ficha">
        <tr>
          <td class="etiqueta">Son</td>
          <td class="i">{{totalLetras}}</td>
        </tr>
        <tr>
          <td class="etiqueta">Lugar de entrega / prestación</td>
          <td>{{lugarEntrega}}</td>
        </tr>
        <tr>
          <td class="etiqueta">Forma de pago</td>
          <td>{{formaPago}}</td>
        </tr>
        <tr>
          <td class="etiqueta">Garantía</td>
          <td>{{garantia}}</td>
        </tr>
        {{#if observaciones}}
          <tr>
            <td class="etiqueta">Observaciones</td>
            <td class="pre">{{observaciones}}</td>
          </tr>
        {{/if}}
      </table>

      <table class="firmas no-romper">
        <tr>
          <td>
            <div class="firma-linea">Elaborado por</div>
            <div class="firma-nombre">{{preparadoPor}}</div>
          </td>
          <td>
            <div class="firma-linea">{{cargoDirectorFinanciero}}</div>
            <div class="firma-nombre">{{directorFinanciero}}</div>
          </td>
          <td>
            <div class="firma-linea">{{cargoDirectorEjecutivo}}</div>
            <div class="firma-nombre">{{directorEjecutivo}}</div>
          </td>
        </tr>
      </table>

      <div class="recuadro no-romper" style="margin-top: 10mm">
        <div class="b">CONFORMIDAD DE RECEPCIÓN</div>
        <table class="recepcion">
          <tr>
            <td>
              <table class="datos">
                <tr>
                  <td class="etiqueta">Fecha de recepción:</td>
                  <td class="valor">&nbsp;</td>
                </tr>
                <tr>
                  <td class="etiqueta">Observaciones:</td>
                  <td class="valor">&nbsp;</td>
                </tr>
              </table>
            </td>
            <td>
              <table class="firmas" style="margin-top: 12mm">
                <tr>
                  <td>
                    <div class="firma-linea">Firma y sello de recepción</div>
                    <div class="firma-nombre">Nombre y cargo</div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
        </table>
      </div>
    </div>
  </body>
</html>

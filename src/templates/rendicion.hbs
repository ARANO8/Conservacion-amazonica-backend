<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rendición de Cuentas — {{solicitud.codigoSolicitud}}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
      @page {
        size: A4;
        margin: 10mm 12mm;
      }
      body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #1e293b;
      }
      .page-break {
        page-break-before: always;
      }
      .no-break {
        break-inside: avoid;
        page-break-inside: avoid;
      }
    </style>
  </head>
  <body class="bg-white text-[10px] leading-normal">
    <!-- Header Principal -->
    <header class="mb-4 flex items-center justify-between border-b-2 border-slate-900 pb-3">
      <div class="flex items-center gap-3">
        {{#if logoBase64}}
          <img
            src="data:image/png;base64,{{logoBase64}}"
            alt="Logo ACCA"
            class="h-12 w-auto object-contain"
          />
        {{else}}
          <div class="rounded border border-slate-800 px-2 py-1 text-xs font-bold uppercase tracking-wider text-slate-800">
            Conservación Amazónica
          </div>
        {{/if}}
        <div>
          <p class="text-[8px] font-bold text-slate-500 uppercase tracking-widest">Asociación Conservación Amazónica</p>
          <p class="text-[8px] text-slate-400">Generado: {{generatedAt}}</p>
        </div>
      </div>

      <div class="text-right">
        <h1 class="text-base font-extrabold text-slate-900 uppercase">
          Anexo 4: Rendición de Cuentas
        </h1>
        <p class="text-[9px] font-bold text-slate-500">ID de Control: {{id}}</p>
      </div>
    </header>

    <!-- Datos Generales (DE / A / PROYECTO / FECHA) -->
    <section class="mb-4 bg-slate-50 rounded-md border border-slate-200 p-3 no-break">
      <div class="grid grid-cols-2 gap-x-6 gap-y-1.5 text-[9.5px]">
        <div>
          <span class="font-bold text-slate-600">DE (Beneficiario):</span>
          <span class="font-medium">{{usuario.nombre}} ({{usuario.cargo}})</span>
        </div>
        <div>
          <span class="font-bold text-slate-600">FECHA DE RENDICIÓN:</span>
          <span class="font-medium">{{fechaRendicion}}</span>
        </div>
        <div>
          <span class="font-bold text-slate-600">A (Aprobador Inmediato):</span>
          <span class="font-medium">{{firmas.directorProyecto.nombre}} ({{firmas.directorProyecto.cargo}})</span>
        </div>
        <div>
          <span class="font-bold text-slate-600">CÓDIGO SOLICITUD:</span>
          <span class="font-mono font-bold text-slate-900">{{solicitud.codigoSolicitud}}</span>
        </div>
        <div class="col-span-2">
          <span class="font-bold text-slate-600">PROYECTO / POA:</span>
          <span class="font-medium">{{solicitud.proyecto}}</span>
        </div>
        <div class="col-span-2 border-t border-slate-200 pt-1.5 mt-0.5">
          <span class="font-bold text-slate-600">MOTIVO DE DESEMBOLSO:</span>
          <span class="font-medium text-slate-700">{{solicitud.motivoViaje}}</span>
        </div>
      </div>
    </section>

    <!-- Resumen de Caja (Cierre de Balance) -->
    <section class="mb-4 no-break">
      <div class="grid grid-cols-3 gap-3">
        <div class="rounded-md border border-emerald-200 bg-emerald-50/50 p-2.5">
          <p class="text-[8px] font-bold uppercase text-emerald-700">1. Anticipo Recibido (Ingreso)</p>
          <p class="mt-1 text-sm font-extrabold text-emerald-800">{{montoRecibido}}</p>
        </div>
        <div class="rounded-md border border-blue-200 bg-blue-50/50 p-2.5">
          <p class="text-[8px] font-bold uppercase text-blue-700">2. Gastos Totales (Egreso)</p>
          <p class="mt-1 text-sm font-extrabold text-blue-800">{{totalPresupuestado}}</p>
        </div>
        <div class="rounded-md border {{#if saldoEsDevolucion}}border-amber-200 bg-amber-50/50{{else}}border-red-200 bg-red-50/50{{/if}} p-2.5">
          <p class="text-[8px] font-bold uppercase {{#if saldoEsDevolucion}}text-amber-700{{else}}text-red-700{{/if}}">
            3. Saldo Líquido {{#if saldoEsDevolucion}}(A Devolver){{else}}(A Reembolsar){{/if}}
          </p>
          <p class="mt-1 text-sm font-extrabold {{#if saldoEsDevolucion}}text-amber-800{{else}}text-red-800{{/if}}">{{saldoLiquidoFormat}}</p>
        </div>
      </div>
      <p class="mt-1.5 text-[8.5px] italic text-slate-500 font-medium">
        Estado del balance: <span class="font-bold text-slate-700">{{saldoStatus}}</span>
      </p>
    </section>

    <!-- Transacciones (Libro Diario de Caja) -->
    <section class="mb-4">
      <h2 class="mb-1.5 text-[10px] font-extrabold uppercase tracking-wider text-slate-800">
        Detalle Cronológico de Transacciones (Libro de Movimientos)
      </h2>
      <table class="w-full border-collapse border border-slate-300 text-[8.5px]">
        <thead>
          <tr class="bg-slate-800 text-white font-bold uppercase text-[8px]">
            <th class="border border-slate-300 px-1.5 py-1 text-left w-[65px]">Fecha</th>
            <th class="border border-slate-300 px-1.5 py-1 text-left w-[110px]">Comprobante / Tipo</th>
            <th class="border border-slate-300 px-1.5 py-1 text-center w-[50px]">Partida</th>
            <th class="border border-slate-300 px-1.5 py-1 text-left">Concepto / Actividad</th>
            <th class="border border-slate-300 px-1.5 py-1 text-left w-[120px]">Proveedor / Beneficiario</th>
            <th class="border border-slate-300 px-1.5 py-1 text-right w-[60px]">Ingreso (+)</th>
            <th class="border border-slate-300 px-1.5 py-1 text-right w-[60px]">Egreso (-)</th>
            <th class="border border-slate-300 px-1.5 py-1 text-right w-[60px]">Saldo</th>
            <th class="border border-slate-300 px-1.5 py-1 text-right w-[60px]">Total</th>
            <th class="border border-slate-300 px-1.5 py-1 text-right w-[55px]">RC-IVA 13%</th>
            <th class="border border-slate-300 px-1.5 py-1 text-right w-[50px]">IUE 5%</th>
            <th class="border border-slate-300 px-1.5 py-1 text-right w-[50px]">IT 3%</th>
            <th class="border border-slate-300 px-1.5 py-1 text-right w-[60px]">Total imp.</th>
            <th class="border border-slate-300 px-1.5 py-1 text-right w-[60px]">Neto</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200">
          {{#each transacciones}}
            <tr class="odd:bg-white even:bg-slate-50/50">
              <td class="border border-slate-300 px-1.5 py-1 font-mono text-slate-600">{{fecha}}</td>
              <td class="border border-slate-300 px-1.5 py-1 uppercase text-slate-700 font-semibold">{{comprobante}}</td>
              <td class="border border-slate-300 px-1.5 py-1 text-center font-mono font-bold text-slate-800">{{partida}}</td>
              <td class="border border-slate-300 px-1.5 py-1 text-slate-700 max-w-[200px] truncate">{{concepto}}</td>
              <td class="border border-slate-300 px-1.5 py-1 text-slate-600 max-w-[120px] truncate">{{proveedor}}</td>
              <td class="border border-slate-300 px-1.5 py-1 text-right font-mono text-emerald-700 font-semibold">{{ingreso}}</td>
              <td class="border border-slate-300 px-1.5 py-1 text-right font-mono text-red-700 font-semibold">{{egreso}}</td>
              <td class="border border-slate-300 px-1.5 py-1 text-right font-mono font-bold text-slate-900">{{saldo}}</td>
              <td class="border border-slate-300 px-1.5 py-1 text-right font-mono text-slate-700">{{total}}</td>
              <td class="border border-slate-300 px-1.5 py-1 text-right font-mono text-slate-600">{{rcIva}}</td>
              <td class="border border-slate-300 px-1.5 py-1 text-right font-mono text-slate-600">{{iue}}</td>
              <td class="border border-slate-300 px-1.5 py-1 text-right font-mono text-slate-600">{{it}}</td>
              <td class="border border-slate-300 px-1.5 py-1 text-right font-mono font-semibold text-slate-700">{{totalImpuestos}}</td>
              <td class="border border-slate-300 px-1.5 py-1 text-right font-mono font-bold text-slate-900">{{neto}}</td>
            </tr>
          {{/each}}
          <tr class="bg-slate-100 font-bold uppercase text-[8px]">
            <td colspan="5" class="border border-slate-300 px-1.5 py-1 text-right">Totales</td>
            <td class="border border-slate-300 px-1.5 py-1 text-right font-mono text-emerald-700">{{totalesTransacciones.ingreso}}</td>
            <td class="border border-slate-300 px-1.5 py-1 text-right font-mono text-red-700">{{totalesTransacciones.egreso}}</td>
            <td class="border border-slate-300 px-1.5 py-1 text-right font-mono">{{totalesTransacciones.saldo}}</td>
            <td class="border border-slate-300 px-1.5 py-1 text-right font-mono">{{totalesTransacciones.total}}</td>
            <td class="border border-slate-300 px-1.5 py-1 text-right font-mono">{{totalesTransacciones.rcIva}}</td>
            <td class="border border-slate-300 px-1.5 py-1 text-right font-mono">{{totalesTransacciones.iue}}</td>
            <td class="border border-slate-300 px-1.5 py-1 text-right font-mono">{{totalesTransacciones.it}}</td>
            <td class="border border-slate-300 px-1.5 py-1 text-right font-mono">{{totalesTransacciones.totalImpuestos}}</td>
            <td class="border border-slate-300 px-1.5 py-1 text-right font-mono">{{totalesTransacciones.neto}}</td>
          </tr>
        </tbody>
      </table>
    </section>

    <!-- Liquidación de caja y conteo de documentos (ANEXO 4) -->
    <section class="mb-4 no-break">
      <div class="grid grid-cols-2 gap-3">
        <div class="rounded-md border border-slate-200 p-3">
          <h2 class="mb-2 text-[9px] font-extrabold uppercase tracking-wider text-slate-800">
            Liquidación de Caja
          </h2>
          <div class="space-y-1 text-[9px]">
            <div class="flex justify-between">
              <span class="text-slate-600">Importe recibido:</span>
              <span class="font-mono font-semibold">{{montoRecibido}}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-600">Total gastado (efectivo):</span>
              <span class="font-mono font-semibold">{{totalEfectivoPagado}}</span>
            </div>
            <div class="flex justify-between border-t border-slate-200 pt-1">
              <span class="font-bold text-slate-700">Saldo:</span>
              <span class="font-mono font-bold">{{saldoEfectivo}}</span>
            </div>
          </div>
          <div class="mt-2 grid grid-cols-2 gap-2">
            <div class="rounded border {{#if aFavorEmpleado}}border-amber-300 bg-amber-50{{else}}border-dashed border-slate-200{{/if}} px-2 py-1.5">
              <p class="text-[7.5px] font-bold uppercase text-slate-600">A favor del empleado</p>
              <p class="font-mono text-[10px] font-extrabold">{{#if aFavorEmpleado}}{{aFavorEmpleado}}{{else}}—{{/if}}</p>
            </div>
            <div class="rounded border {{#if aFavorProyecto}}border-emerald-300 bg-emerald-50{{else}}border-dashed border-slate-200{{/if}} px-2 py-1.5">
              <p class="text-[7.5px] font-bold uppercase text-slate-600">A favor del proyecto</p>
              <p class="font-mono text-[10px] font-extrabold">{{#if aFavorProyecto}}{{aFavorProyecto}}{{else}}—{{/if}}</p>
            </div>
          </div>
        </div>

        <div class="rounded-md border border-slate-200 p-3">
          <h2 class="mb-2 text-[9px] font-extrabold uppercase tracking-wider text-slate-800">
            Documentos de Respaldo
          </h2>
          <table class="w-full border-collapse text-[8.5px]">
            <thead>
              <tr class="bg-slate-100 text-slate-700 text-[8px] uppercase">
                <th class="border border-slate-300 px-2 py-1 text-left">Documentos</th>
                <th class="border border-slate-300 px-2 py-1 text-center w-[50px]">Cant.</th>
                <th class="border border-slate-300 px-2 py-1 text-right w-[80px]">Monto Bs</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="border border-slate-300 px-2 py-1">Facturas</td>
                <td class="border border-slate-300 px-2 py-1 text-center font-mono">{{conteoDocumentos.facturasCantidad}}</td>
                <td class="border border-slate-300 px-2 py-1 text-right font-mono">{{conteoDocumentos.facturasMonto}}</td>
              </tr>
              <tr>
                <td class="border border-slate-300 px-2 py-1">Recibos y otros</td>
                <td class="border border-slate-300 px-2 py-1 text-center font-mono">{{conteoDocumentos.recibosCantidad}}</td>
                <td class="border border-slate-300 px-2 py-1 text-right font-mono">{{conteoDocumentos.recibosMonto}}</td>
              </tr>
              <tr class="bg-slate-100 font-bold">
                <td class="border border-slate-300 px-2 py-1">TOTAL</td>
                <td class="border border-slate-300 px-2 py-1 text-center font-mono">{{conteoDocumentos.totalCantidad}}</td>
                <td class="border border-slate-300 px-2 py-1 text-right font-mono">{{conteoDocumentos.totalMonto}}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Resumen Contable por Partida (Presupuestario) -->
    <section class="mb-4 no-break">
      <h2 class="mb-1.5 text-[10px] font-extrabold uppercase tracking-wider text-slate-800">
        Resumen Presupuestario Afectado por Partida
      </h2>
      <table class="w-full border-collapse border border-slate-300 text-[8.5px]">
        <thead>
          <tr class="bg-slate-100 text-slate-800 font-bold uppercase text-[8px] border-b-2 border-slate-400">
            <th class="border border-slate-300 px-2 py-1 text-center w-[70px]">Código Partida</th>
            <th class="border border-slate-300 px-2 py-1 text-left">Descriptor Partida</th>
            <th class="border border-slate-300 px-2 py-1 text-right w-[100px]">Monto Neto</th>
            <th class="border border-slate-300 px-2 py-1 text-right w-[100px]">Retenciones / Impuestos</th>
            <th class="border border-slate-300 px-2 py-1 text-right w-[100px]">Total Afectado (Bruto)</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200">
          {{#each resumenContable}}
            <tr>
              <td class="border border-slate-300 px-2 py-1.5 text-center font-mono font-bold bg-slate-50/50 text-slate-800">{{codigo}}</td>
              <td class="border border-slate-300 px-2 py-1.5 text-slate-700 font-medium">{{concepto}}</td>
              <td class="border border-slate-300 px-2 py-1.5 text-right font-mono">{{montoNeto}}</td>
              <td class="border border-slate-300 px-2 py-1.5 text-right font-mono text-slate-500 font-semibold">{{montoImpuestos}}</td>
              <td class="border border-slate-300 px-2 py-1.5 text-right font-mono font-bold text-slate-900 bg-slate-50/50">{{montoBruto}}</td>
            </tr>
          {{/each}}
          <tr class="bg-slate-100 font-bold uppercase">
            <td colspan="2" class="border border-slate-300 px-2 py-1.5 text-right">Totales Consolidados</td>
            <td class="border border-slate-300 px-2 py-1.5 text-right font-mono">{{totalEfectivoPagado}}</td>
            <td class="border border-slate-300 px-2 py-1.5 text-right font-mono text-slate-600">{{totalImpuestosRetenidos}}</td>
            <td class="border border-slate-300 px-2 py-1.5 text-right font-mono text-slate-900 bg-slate-200/80">{{totalPresupuestado}}</td>
          </tr>
        </tbody>
      </table>
    </section>

    <!-- Firmas Oficiales de Descargo (Tres Columnas) -->
    <section class="mt-8 no-break">
      <div class="grid grid-cols-3 gap-8 text-center text-[9px]">
        <div class="flex flex-col justify-between items-center h-[75px]">
          <div class="w-40 border-b border-slate-400 mt-auto"></div>
          <div>
            <p class="font-bold text-slate-800">Firma del Solicitante</p>
            <p class="text-slate-500">{{firmas.emitidoPor.nombre}}</p>
            <p class="text-[7.5px] uppercase tracking-wider text-slate-400 font-medium">{{firmas.emitidoPor.cargo}}</p>
          </div>
        </div>

        <div class="flex flex-col justify-between items-center h-[75px]">
          <div class="w-40 border-b border-slate-400 mt-auto"></div>
          <div>
            <p class="font-bold text-slate-800">Firma de Revisión (V°B°)</p>
            <p class="text-slate-500">{{firmas.directorProyecto.nombre}}</p>
            <p class="text-[7.5px] uppercase tracking-wider text-slate-400 font-medium">{{firmas.directorProyecto.cargo}}</p>
          </div>
        </div>

        <div class="flex flex-col justify-between items-center h-[75px]">
          <div class="w-40 border-b border-slate-400 mt-auto"></div>
          <div>
            <p class="font-bold text-slate-800">Autorizado / Aprobado por</p>
            <p class="text-slate-500">{{firmas.aprobadoPor.nombre}}</p>
            <p class="text-[7.5px] uppercase tracking-wider text-slate-400 font-medium">{{firmas.aprobadoPor.cargo}}</p>
          </div>
        </div>
      </div>
    </section>
  </body>
</html>

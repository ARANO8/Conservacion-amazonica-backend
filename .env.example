# Conexion a PostgreSQL
DATABASE_URL="postgresql://usuario:contrasena@localhost:5432/amazonica_db?schema=public"

# Secreto para firmar los JWT. DEBE ser un valor aleatorio fuerte de al menos
# 32 caracteres. Generalo, por ejemplo, con: openssl rand -hex 32
JWT_SECRET="genera-un-secreto-aleatorio-fuerte-de-32-o-mas-caracteres"

# Vigencia del token (opcional, por defecto 24h). Formato: 60s, 30m, 24h, 7d
JWT_EXPIRES_IN="24h"

# URL del frontend permitido por CORS
FRONTEND_URL="http://localhost:3001"

# (Opcional) Contrasena fija para los usuarios que crea el seed en desarrollo.
# Si no se define, el seed genera una contrasena aleatoria distinta por usuario.
SEED_PASSWORD=""

# Conexion a PostgreSQL
DATABASE_URL="postgresql://usuario:contrasena@localhost:5432/amazonica_db?schema=public"

# Secreto para firmar los JWT. DEBE ser un valor aleatorio fuerte de al menos
# 32 caracteres. Generalo, por ejemplo, con: openssl rand -hex 32
JWT_SECRET="genera-un-secreto-aleatorio-fuerte-de-32-o-mas-caracteres"

# Vigencia del token (opcional, por defecto 24h). Formato: 60s, 30m, 24h, 7d
JWT_EXPIRES_IN="24h"

# URL del frontend permitido por CORS. Es un origen unico, no una lista, y va
# sin barra final. En el VPS el frontend comparte dominio con la API, asi que
# aqui va https://tu-subdominio y no hay preflight de por medio.
FRONTEND_URL="http://localhost:3001"

# Puerto en el que escucha la API (opcional, por defecto 3000)
PORT=3000

# "production" activa el flag Secure de la cookie de sesion, lo que exige HTTPS.
# En desarrollo dejalo sin definir o en "development".
NODE_ENV="development"

# Rate limiting global (opcionales). Ventana en milisegundos y peticiones
# permitidas por ventana. Por defecto: 60000 y 10.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=10

# Ruta al ejecutable de Chromium que usa Puppeteer para generar los PDF. Si no
# se define, Puppeteer usa el navegador que descargo al instalarse.
# En la imagen Docker es /usr/bin/chromium; en Windows, la ruta de Chrome.
PUPPETEER_EXECUTABLE_PATH=""

# (Opcional) Contrasena fija para los usuarios que crea el seed en desarrollo.
# Si no se define, el seed genera una contrasena aleatoria distinta por usuario.
SEED_PASSWORD=""

# Plantilla de /opt/amzdesk/.env en el VPS.
#
# Copiala al VPS, rellena los valores reales y protegela con `chmod 600 .env`.
# NUNCA la subas a git con valores reales.

# --- PostgreSQL -------------------------------------------------------------
# Credenciales nuevas y fuertes. No reutilices las de desarrollo (admin/root).
POSTGRES_USER=amzdesk
POSTGRES_PASSWORD=CAMBIAME_password_larga_y_aleatoria
POSTGRES_DB=amazonica_db

# El host es `db`: el nombre del servicio dentro de la red del compose.
# Debe coincidir con las tres variables de arriba.
DATABASE_URL=postgresql://amzdesk:CAMBIAME_password_larga_y_aleatoria@db:5432/amazonica_db?schema=public

# --- API --------------------------------------------------------------------
# Minimo 32 caracteres o la aplicacion no arranca. Generalo con:
#   openssl rand -hex 32
JWT_SECRET=CAMBIAME_generado_con_openssl_rand_hex_32
JWT_EXPIRES_IN=24h

# Origen publico del sistema, sin barra final. Frontend y API comparten dominio.
FRONTEND_URL=https://tu-subdominio.tudominio.com

# Rate limiting: peticiones por ventana y por IP. El valor por defecto del
# codigo (10) es de desarrollo y resulta corto para el dashboard.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# --- Imagenes desplegadas ---------------------------------------------------
# Las actualiza GitHub Actions en cada despliegue. Para hacer rollback, apunta
# la variable a una etiqueta sha-* anterior y ejecuta:
#   docker compose up -d <servicio>
BACKEND_IMAGE=ghcr.io/arano8/conservacion-amazonica-backend:latest
FRONTEND_IMAGE=ghcr.io/arano8/conservacion-amazonica-frontend:latest
